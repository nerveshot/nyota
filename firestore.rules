rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // NYOTA NAMESPACE RULES
    // Isolated top-level 'nyota' collection for the Nyota Invitations platform
    // Shared Firebase project: faizansalam
    // =========================================================================
    match /nyota/{module}/items/{documentId} {
      
      // 1. Invitations (/nyota/invitations/items/{id})
      // Public read for published invitations, write for creators/authenticated hosts
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['title', 'primaryNames']);
      allow delete: if request.auth != null;

      // 2. RSVPs (/nyota/rsvps/items/{id})
      // Public read and create for invited guests
      allow read: if true;
      allow create: if request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow update, delete: if true; // Host or guest management

      // 3. Orders (/nyota/orders/items/{id})
      // Secure creation for checkout purchases
      allow read: if true;
      allow create: if request.resource.data.amount is number;
      allow update, delete: if request.auth != null;

      // 4. Newsletter (/nyota/newsletter/items/{id})
      allow read: if request.auth != null;
      allow create, update: if request.resource.data.email is string;

      // 5. System Config & Templates
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback for any other top-level collection in faizansalam project:
    // Retain existing security rules for non-nyota projects
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
