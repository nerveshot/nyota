rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'faizansalam@icloud.com' ||
        request.auth.token.email.lower() == 'faizansalam'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection (/nyota/users/items/{userId})
    match /nyota/users/items/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 2. Orders Collection (/nyota/orders/items/{orderId})
    match /nyota/orders/items/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 3. Invitations Collection (/nyota/invitations/items/{invitationId})
    match /nyota/invitations/items/{invitationId} {
      allow read: if true; // Public access for guests viewing invitations
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 4. RSVPs Collection (/nyota/rsvps/items/{rsvpId})
    match /nyota/rsvps/items/{rsvpId} {
      allow create, read: if true; // Public guest RSVP submissions
      allow update, delete: if isAuthenticated() || isAdmin();
    }

    // 5. Newsletter / Guestbook / Analytics
    match /nyota/newsletter/items/{subId} {
      allow create, read: if true;
      allow write: if isAdmin();
    }

    // 6. Generic Nyota Fallback
    match /nyota/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }
  }
}
