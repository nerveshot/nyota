rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'faizansalam@icloud.com' ||
        request.auth.token.email.lower() == 'faizansalam'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Invitations Collection (/invitations/{invitationId})
    match /invitations/{invitationId} {
      allow read: if true; // Public access so guests can open invitations
      allow create, update: if true; // Allows registered users and drafts to save/publish
      allow delete: if isAuthenticated() || isAdmin();
    }

    // 2. Users Collection (/users/{userId})
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin() || isAuthenticated();
    }

    // 3. Orders Collection (/orders/{orderId})
    match /orders/{orderId} {
      allow create, read: if true;
      allow update, delete: if isAuthenticated() || isAdmin();
    }

    // 4. RSVPs Collection (/rsvps/{rsvpId})
    match /rsvps/{rsvpId} {
      allow create, read: if true; // Public guest RSVP submissions
      allow update, delete: if isAuthenticated() || isAdmin();
    }

    // 5. Fallback for any other collections / legacy paths
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}

